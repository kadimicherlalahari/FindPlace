# ---- Server ----
PORT=3000
# Public URL of this app, used for the private links posted in Telegram.
# On Vercel set it to your https domain, e.g. https://flat-hunt.vercel.app
APP_URL=http://localhost:3000

# ---- Supabase (required on Vercel; leave blank locally to use ./data) ----
# Project URL, e.g. https://abcd1234.supabase.co
SUPABASE_URL=
# Service-role key: server-side only, never ship to the browser
SUPABASE_SERVICE_ROLE_KEY=

# ---- Listings ----
# "rapidapi" for live listings, "mock" for built-in sample data
LISTINGS_PROVIDER=mock
RAPIDAPI_KEY=
# Host of the RapidAPI API you subscribed to, e.g. some-rentals-api.p.rapidapi.com
RAPIDAPI_HOST=
# Field mapping for that API (see src/providers/rapidapi.config.json)
RAPIDAPI_CONFIG=src/providers/rapidapi.config.json
# Max results pages to fetch per location
RAPIDAPI_MAX_PAGES=2

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
# "polling" locally (no public URL needed). Vercel always uses "webhook".
TELEGRAM_MODE=polling
# Webhook mode only: any long random string. Telegram sends it with every
# update so the app can reject fake requests. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=

# ---- Gemini ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Commute estimation ----
# "nominatim" (OpenStreetMap geocoding, free, 1 req/s) or "none"
GEOCODER=nominatim
# Contact string sent in the User-Agent, required by the Nominatim usage policy
GEOCODER_CONTACT=apartment-matchmaker
